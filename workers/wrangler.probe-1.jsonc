{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vgate-tcp-probe-1",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "observability": {"enabled": true},
  "triggers": {"crons": ["4-59/5 * * * *"]},
  "vars": {"WORKER_ID": "1", "REPOSITORY": "GeorgeXie2333/vpngate-list-mirror", "MAX_TARGETS_PER_RUN": "40"},
  "kv_namespaces": [{"binding": "RESULTS", "id": "REPLACE_WITH_SHARED_KV_NAMESPACE_ID"}]
}
