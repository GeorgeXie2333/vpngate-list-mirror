{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "VPN Gate mirror countries v1",
  "required": [
    "schema_version",
    "source_csv_sha256",
    "server_count",
    "countries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_csv_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "server_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "code",
          "names",
          "server_count"
        ],
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "not": {
                  "enum": [
                    "XX",
                    "ZZ"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "server_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        },
        "additionalProperties": true
      }
    }
  }
}
