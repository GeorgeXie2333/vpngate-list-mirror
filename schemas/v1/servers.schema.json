{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "VPN Gate mirror servers v1",
  "required": [
    "schema_version",
    "source_csv_sha256",
    "server_count",
    "servers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_csv_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "server_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": [
        "id",
        "hostname",
        "ip",
        "country_code",
        "country_name",
        "score",
        "ping_ms",
        "speed_bps",
        "num_vpn_sessions",
        "openvpn_config_base64",
        "openvpn_config_sha256",
        "openvpn_config_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^v1:[0-9a-f]{64}$"
        },
        "hostname": {
          "type": "string",
          "description": "Original CSV HostName identifier; may contain underscores and is not necessarily a DNS name.",
          "minLength": 1,
          "maxLength": 254
        },
        "ip": {
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4"
            },
            {
              "type": "string",
              "format": "ipv6"
            }
          ]
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "not": {
                "enum": [
                  "XX",
                  "ZZ"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "country_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ping_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speed_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "num_vpn_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "openvpn_config_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 4,
          "maxLength": 174764,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "openvpn_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "openvpn_config_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        }
      },
      "additionalProperties": true
    }
  }
}
