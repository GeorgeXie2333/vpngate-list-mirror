{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VPN Gate pool v1 bucket",
  "type": "object",
  "required": [
    "schema_version",
    "bucket",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bucket": {
      "type": "integer",
      "minimum": 0,
      "maximum": 143
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/target"
      },
      "maxItems": 5000
    }
  },
  "additionalProperties": true
}
