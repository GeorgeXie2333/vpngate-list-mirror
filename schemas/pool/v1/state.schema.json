{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VPN Gate pool v1 state",
  "type": "object",
  "required": [
    "schema_version",
    "processed_batches"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "processed_batches": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      }
    }
  },
  "additionalProperties": true
}
