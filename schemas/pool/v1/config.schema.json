{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VPN Gate pool v1 config",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "openvpn_config_base64",
    "openvpn_config_sha256",
    "openvpn_config_bytes"
  ],
  "properties": {
    "kind": {
      "const": "vpngate-pool-config"
    },
    "schema_version": {
      "const": 1
    },
    "openvpn_config_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 174764,
      "contentEncoding": "base64"
    },
    "openvpn_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "openvpn_config_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 131072
    }
  },
  "additionalProperties": true
}
